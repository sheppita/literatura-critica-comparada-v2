<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho"><a href="/">Início</a> › Infos</p>

  <h1>Painel de Controle</h1>
  <p class="subtitulo">Estatísticas gerais do acervo e da ementa</p>

  <div class="dashboard-grid">
    
    <!-- CARD: EMENTA -->
    <div class="dashboard-card">
      <h2>Ementa Curricular</h2>
      <p class="dash-total"><%= dados.ementa.total %> <span>itens totais</span></p>
      <ul class="dash-list">
        <li><span>Eixos:</span> <strong><%= dados.ementa.eixos %></strong></li>
        <li><span>Disciplinas:</span> <strong><%= dados.ementa.disciplinas %></strong></li>
        <li><span>Temas:</span> <strong><%= dados.ementa.temas %></strong></li>
        <li><span>Aulas:</span> <strong><%= dados.ementa.aulas %></strong></li>
      </ul>
    </div>

    <!-- CARD: BIBLIOGRAFIA -->
    <div class="dashboard-card">
      <h2>Bibliografia</h2>
      <p class="dash-total"><%= dados.bibliografia.obras %> <span>obras ativas</span></p>
      <ul class="dash-list">
        <li><span>Autores distintos:</span> <strong><%= dados.bibliografia.autores %></strong></li>
        <li><span>Edições cadastradas:</span> <strong><%= dados.bibliografia.edicoes %></strong></li>
        <li><span>Indicações de uso:</span> <strong><%= dados.bibliografia.usos %></strong></li>
        <li><span>Usos validados:</span> <strong><%= dados.bibliografia.usos_validados %></strong></li>
      </ul>
    </div>

        <div class="dashboard-card">
      <h2>Top 10 Autores</h2>
      <% if (dados.topAutores.length === 0) { %>
        <p class="dash-note">Nenhum autor usado ainda.</p>
      <% } else { %>
        <ul class="dash-list">
          <% for (const a of dados.topAutores) { %>
            <li>
              <strong><%= a.autor %></strong>
              <span><%= a.total_usos %> uso<%= a.total_usos === 1 ? '' : 's' %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>

    <div class="dashboard-card">
      <h2>Top 10 Países</h2>
      <% if (dados.topPaises.length === 0) { %>
        <p class="dash-note">Nenhum país informado ainda.</p>
      <% } else { %>
        <ul class="dash-list">
          <% for (const p of dados.topPaises) { %>
            <li>
              <strong><%= p.pais %></strong>
              <span><%= p.total_usos %> uso<%= p.total_usos === 1 ? '' : 's' %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>

  </div>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>