<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a>
    <% for (const u of cadeia) { %>
      › <a href="/unidades/<%= u.id %>"><%= u.titulo %></a>
    <% } %>
    › <a href="/unidades/<%= unidade.id %>"><%= unidade.titulo %></a>
    › Editar Ficha
  </p>

  <h1>Editar Ficha</h1>
  <p class="subtitulo"><%= unidade.titulo %></p>

  <% if (conflito) { %>
    <div class="aviso-conflito">
      <strong>Conflito de versão.</strong>
      Você abriu esta ficha na <strong>v<%= conflito.versaoQueAbri %></strong>,
      mas ela já está na <strong>v<%= conflito.versaoAtual %></strong>.
      Alguém (ou você em outra aba) salvou uma nova versão nesse meio-tempo.
      <p style="margin: 0.75rem 0 0;">
        <a href="/unidades/<%= unidade.id %>/ficha/editar"
           class="botao-ghost" style="margin-right: 0.5rem;">
          Recarregar (Perder minhas mudanças)
        </a>
        <form method="POST" action="/unidades/<%= unidade.id %>/ficha/editar"
              style="display: inline;"
              onsubmit="return confirm('Isso vai sobrescrever a versão mais recente com o seu conteúdo. Tem certeza?');">
          <input type="hidden" name="conteudo_html" value="<%= valores.conteudo_html %>">
          <input type="hidden" name="versao_que_abri" value="<%= conflito.versaoQueAbri %>">
          <input type="hidden" name="forcar" value="1">
          <button type="submit" class="perigo">Salvar Mesmo Assim</button>
        </form>
      </p>
    </div>
  <% } %>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/unidades/<%= unidade.id %>/ficha/editar" id="form-ficha">
    <input type="hidden" name="versao_que_abri" value="<%= ficha.versao_atual %>">
    <input type="hidden" name="conteudo_html" id="conteudo_html_hidden">

    <div class="faixa-versao">
      v<%= ficha.versao_atual %>
      <% if (ficha.atualizado_em) { %>
        · Editada em <%= new Date(ficha.atualizado_em).toLocaleDateString('pt-BR') %>
      <% } %>
    </div>

    <div id="editor-quill"></div>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="botao-ghost" href="/unidades/<%= unidade.id %>" id="btn-cancelar">Cancelar</a>
    </div>
  </form>

  <%- include('./partials/botoes-flutuantes') %>

  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script>
    (function () {
      const conteudoInicial = <%- JSON.stringify(valores.conteudo_html || "") %>;

      const quill = new Quill("#editor-quill", {
        theme: "snow",
        modules: {
          toolbar: [
            [{ header: [2, 3, false] }],
            ["bold", "italic", "underline"],
            [{ list: "ordered" }, { list: "bullet" }],
            ["blockquote", "link"],
            ["clean"]
          ]
        }
      });

      // Carrega o conteúdo inicial no Quill.
      // Se for HTML (fichas convertidas), ele renderiza formatado.
      // Se for vazio, fica em branco.
      if (conteudoInicial) {
        quill.clipboard.dangerouslyPasteHTML(conteudoInicial);
      }

      const form = document.getElementById("form-ficha");
      const hidden = document.getElementById("conteudo_html_hidden");

      // Sincroniza o HTML do Quill para o campo escondido no submit.
      form.addEventListener("submit", () => {
        // Pega o HTML do conteúdo interno do Quill.
        const editorContent = document.querySelector("#editor-quill .ql-editor");
        hidden.value = editorContent.innerHTML;
      });

      // Se o conteúdo inicial estiver vazio, o Quill coloca um <p><br></p>.
      // A gente limpa na hora de salvar (para o banco não ficar com HTML de placeholder).
      form.addEventListener("submit", () => {
        if (hidden.value === "<p><br></p>") {
          hidden.value = "";
        }
      });
    })();
  </script>
</body>
</html>