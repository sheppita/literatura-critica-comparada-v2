<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
<%- include('./partials/navbar') %>


  <h1><a href="/"><%= titulo %></a></h1>
  <% if (typeof subtitulo !== 'undefined' && subtitulo) { %>
    <p class="subtitulo"><%= subtitulo %></p>
  <% } %>

  <% if (eixos.length === 0) { %>
    <p class="aviso-vazio">
      Nenhum eixo cadastrado ainda. Assim que a tela de cadastro estiver pronta,
      os eixos aparecerão aqui.
    </p>
  <% } else { %>
    <ul>
      <% for (const eixo of eixos) { %>
        <li>
          <% if (eixo.codigo) { %><strong><%= eixo.codigo %></strong> — <% } %>
          <a href="/unidades/<%= eixo.id %>"><%= eixo.titulo %></a>
        </li>
      <% } %>
    </ul>
  <% } %>

  <p style="margin-top: 2rem;">
      <a href="/unidades/nova">+ Novo Eixo</a>
     ·
      <a href="/obras">Bibliografia</a>
  </p>

  <footer>
    <a href="/health">/health</a>
  </footer>
<%- include('./partials/botoes-flutuantes') %>
</body>
</html>