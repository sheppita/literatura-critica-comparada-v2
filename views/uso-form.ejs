<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a>
    <% for (const u of cadeia) { %>
      › <a href="/unidades/<%= u.id %>"><%= u.titulo %></a>
    <% } %>
    › <a href="/unidades/<%= aula.id %>"><%= aula.titulo %></a>
    › <%= modo === 'editar' ? 'Editar Obra' : 'Adicionar Obra' %>
  </p>

  <h1><%= modo === 'editar' ? 'Editar Obra da Aula' : 'Adicionar Obra' %></h1>
  <p class="subtitulo">Aula: <%= aula.titulo %></p>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= acao %>" id="form-uso">
    <label for="obra_busca">Obra</label>
    <div class="autocomplete-container" id="autocomplete-obra">
      <!-- O campo escondido que guarda o ID real para o formulário -->
      <input type="hidden" name="obra_id" id="obra_id" value="<%= valores.obra_id %>">
      
      <!-- O campo de texto que o usuário vê e digita -->
      <input type="text" id="obra_busca" 
             value="<%= (obras.find(o => String(o.id) === String(valores.obra_id)) || {}).titulo || '' %>" 
             placeholder="Digite para buscar..." autocomplete="off">
             
      <!-- Botão de limpar (só aparece se tiver algo escrito) -->
      <button type="button" id="btn-limpar-obra" class="btn-limpar" style="<%= valores.obra_id ? '' : 'display: none;' %>">×</button>
      
      <!-- Lista de resultados -->
      <ul id="lista-busca-obras" class="lista-autocomplete"></ul>
    </div>

    <label for="edicao_id">Edição <span class="ajuda">(Opcional)</span></label>
    <select id="edicao_id" name="edicao_id">
      <option value="">— Edição não especificada —</option>
      <% for (const e of edicoes) { %>
        <option value="<%= e.id %>" <%= valores.edicao_id === String(e.id) ? 'selected' : '' %>>
          <%= e.editora || '—' %><% if (e.ano) { %>, <%= e.ano %><% } %>
        </option>
      <% } %>
    </select>

    <label for="papel">Papel</label>
    <select id="papel" name="papel">
      <% for (const [valor, rotulo] of papeis) { %>
        <option value="<%= valor %>" <%= valores.papel === valor ? 'selected' : '' %>><%= rotulo %></option>
      <% } %>
    </select>

    <label for="modalidade">Modalidade</label>
    <select id="modalidade" name="modalidade">
      <% for (const [valor, rotulo] of modalidades) { %>
        <option value="<%= valor %>" <%= valores.modalidade === valor ? 'selected' : '' %>><%= rotulo %></option>
      <% } %>
    </select>

    <fieldset class="bloco-recortes">
      <legend>Recortes <span class="ajuda">(Capítulos, Seções, Ensaios)</span></legend>

      <div id="lista-recortes">
        <% for (const r of valores.recortes) { %>
          <div class="recorte-linha">
            <input type="text" name="recorte_rotulo[]" placeholder="Rótulo (ex.: Cap. 3)" value="<%= r.rotulo %>">
            <input type="text" name="recorte_observacao[]" placeholder="Observação" value="<%= r.observacao %>">
            <button type="button" class="btn-remover-recorte botao-ghost">×</button>
          </div>
        <% } %>
      </div>

      <p>
        <button type="button" id="btn-add-recorte" class="botao-ghost">+ Adicionar Recorte</button>
      </p>
    </fieldset>

    <label for="orientacao">Orientação/Justificativa <span class="ajuda">(Opcional)</span></label>
    <textarea id="orientacao" name="orientacao"><%= valores.orientacao %></textarea>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="botao-ghost" href="<%= cancelarUrl %>">Cancelar</a>
    </div>
  </form>

  <% if (modo === 'editar') { %>
    <form method="POST" action="/unidades/<%= aula.id %>/usos/<%= valores.uso_id %>/excluir"
          style="margin-top: 2rem;"
          onsubmit="return confirm('Excluir este uso? A obra continua no catálogo.');">
      <button type="submit" class="link-perigo">Excluir Uso</button>
    </form>
  <% } %>

  <template id="molde-recorte">
    <div class="recorte-linha">
      <input type="text" name="recorte_rotulo[]" placeholder="Rótulo (ex.: Cap. 3)">
      <input type="text" name="recorte_observacao[]" placeholder="Observação">
      <button type="button" class="btn-remover-recorte botao-ghost">×</button>
    </div>
  </template>

  <%- include('./partials/botoes-flutuantes') %>

    <script>
    (function () {
      const selectObraAntigo = document.getElementById("obra_id"); // Agora é hidden
      const selectEdicao = document.getElementById("edicao_id");
      const listaRecortes = document.getElementById("lista-recortes");
      const btnAdd = document.getElementById("btn-add-recorte");
      const molde = document.getElementById("molde-recorte");

      // Variáveis do Autocomplete
      const containerAutocomplete = document.getElementById("autocomplete-obra");
      const inputBusca = document.getElementById("obra_busca");
      const listaBusca = document.getElementById("lista-busca-obras");
      const btnLimpar = document.getElementById("btn-limpar-obra");
      let timeoutDebounce;

      async function carregarEdicoes(preservarSelecao) {
        const obraId = selectObraAntigo.value;
        const selecaoAtual = preservarSelecao ? selectEdicao.value : null;
        selectEdicao.innerHTML = '<option value="">— Edição não especificada —</option>';
        if (!obraId) return;
        try {
          const r = await fetch("/obras/" + obraId + "/edicoes.json");
          const dados = await r.json();
          for (const e of dados.edicoes) {
            const opt = document.createElement("option");
            opt.value = e.id;
            let rotulo = e.editora || "—";
            if (e.ano) rotulo += ", " + e.ano;
            opt.textContent = rotulo;
            if (selecaoAtual && String(e.id) === String(selecaoAtual)) {
              opt.selected = true;
            }
            selectEdicao.appendChild(opt);
          }
        } catch (err) {
          // silencioso
        }
      }

      // Se já tem obra_id na edição, carrega as edições
      if (selectObraAntigo.value) {
        carregarEdicoes(true);
      }

      // --- Lógica do Autocomplete ---
      inputBusca.addEventListener("input", (e) => {
        const termo = e.target.value.trim();
        selectObraAntigo.value = ""; // Limpa o ID se o usuário mudar o texto
        btnLimpar.style.display = termo ? "block" : "none";

        clearTimeout(timeoutDebounce);

        if (termo.length < 2) {
          listaBusca.style.display = "none";
          return;
        }

        timeoutDebounce = setTimeout(async () => {
          try {
            const res = await fetch(`/obras/buscar?q=${encodeURIComponent(termo)}`);
            const dados = await res.json();
            
            listaBusca.innerHTML = "";
            if (dados.length === 0) {
              listaBusca.innerHTML = '<li class="vazio">Nenhuma obra encontrada.</li>';
            } else {
              dados.forEach(obra => {
                const li = document.createElement("li");
                li.textContent = obra.titulo + (obra.autores ? ` — ${obra.autores}` : "");
                li.dataset.id = obra.id;
                li.addEventListener("click", () => selecionarObra(obra));
                listaBusca.appendChild(li);
              });
            }
            listaBusca.style.display = "block";
          } catch (err) {
            console.error("Erro na busca", err);
          }
        }, 300);
      });

      // Fecha a lista se clicar fora
      document.addEventListener("click", (e) => {
        if (!containerAutocomplete.contains(e.target)) listaBusca.style.display = "none";
      });

      function selecionarObra(obra) {
        inputBusca.value = obra.titulo + (obra.autores ? ` — ${obra.autores}` : "");
        selectObraAntigo.value = obra.id;
        listaBusca.style.display = "none";
        btnLimpar.style.display = "block";
        
        // Carrega as edições da obra recém-escolhida
        carregarEdicoes(false); 
      }

      btnLimpar.addEventListener("click", () => {
        inputBusca.value = "";
        selectObraAntigo.value = "";
        btnLimpar.style.display = "none";
        listaBusca.style.display = "none";
        inputBusca.focus();
        selectEdicao.innerHTML = '<option value="">— Edição não especificada —</option>';
      });

      // --- Lógica dos Recortes ---
      btnAdd.addEventListener("click", () => {
        const clone = molde.content.cloneNode(true);
        listaRecortes.appendChild(clone);
      });

      listaRecortes.addEventListener("click", (e) => {
        if (e.target.classList.contains("btn-remover-recorte")) {
          const linha = e.target.closest(".recorte-linha");
          if (linha && listaRecortes.children.length > 1) {
            linha.remove();
          }
        }
      });
    })();
  </script>

</body>
</html>