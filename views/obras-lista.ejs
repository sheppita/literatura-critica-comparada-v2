<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a> › Bibliografia
  </p>

  <h1>Bibliografia</h1>
  <p class="subtitulo">Catálogo de obras</p>

  <div class="filtros-capsula">
    <a href="/obras<%= filtros.q ? '?q=' + encodeURIComponent(filtros.q) : '' %>"
       class="capsula <%= !filtros.avaliacao ? 'capsula-ativa' : '' %>">
      Todas
    </a>
    <a href="/obras?avaliacao=a_avaliar<%= filtros.q ? '&q=' + encodeURIComponent(filtros.q) : '' %>"
       class="capsula <%= filtros.avaliacao === 'a_avaliar' ? 'capsula-ativa' : '' %>">
      A Avaliar
    </a>
  </div>

  <form method="GET" action="/obras" class="filtros-obras">
    <% if (filtros.avaliacao) { %>
      <input type="hidden" name="avaliacao" value="<%= filtros.avaliacao %>">
    <% } %>

    <input type="text" name="q" placeholder="Buscar por título ou autoria..."
           value="<%= filtros.q %>">

    <select name="tipo">
      <option value="">Todos os tipos</option>
      <% for (const [valor, rotulo] of tiposMaterial) { %>
        <option value="<%= valor %>" <%= filtros.tipo === valor ? 'selected' : '' %>>
          <%= rotulo %>
        </option>
      <% } %>
    </select>

    <button type="submit">Buscar</button>
    <% if (temFiltro) { %>
      <a href="/obras" class="botao-ghost">Limpar</a>
    <% } %>

    <a href="/obras/nova" class="botao-ghost botao-nova-obra">+ Nova Obra</a>
  </form>

  <% if (obras.length === 0) { %>
    <p class="aviso-vazio">
      <% if (temFiltro) { %>
        Nenhuma obra encontrada com esses filtros.
      <% } else { %>
        Nenhuma obra cadastrada ainda.
      <% } %>
    </p>
  <% } else { %>
    <p class="contador-resultados">
      <%= obras.length %> Obra<%= obras.length === 1 ? '' : 's' %>
      <% if (temFiltro) { %> encontrada<%= obras.length === 1 ? '' : 's' %><% } %>
    </p>
    <table class="tabela-versoes tabela-obras">
      <thead>
        <tr>
          <th></th>
          <th>Livros</th>
          <th>Usos</th>
          <th>Situação</th>
          <th>Edições</th>
        </tr>
      </thead>
      <tbody>
        <% for (const o of obras) { %>
          <tr>
            <td class="celula-capa">
              <% if (o.capa_url) { %>
                <img src="<%= o.capa_url %>" alt="" class="miniatura-capa">
              <% } %>
            </td>
            <td>
              <strong><a href="/obras/<%= o.id %>"><%= o.titulo %></a></strong>
              <% if (o.tem_pendencia) { %>
                <span class="icone-pendencia" title="Há uso com edição não especificada ou recorte a conferir">⚠</span>
              <% } %>
              <% if (o.autores) { %>
                <div class="detalhe-suave"><%= o.autores %></div>
              <% } %>
              <div class="detalhe-suave">
                <%= o.rotuloTipoMaterial %>
              </div>
            </td>
            <td>
              <% if (o.total_aulas_distintas === 0) { %>
                <span class="detalhe-suave">—</span>
              <% } else { %>
                <%= o.total_aulas_distintas %>
                aula<%= o.total_aulas_distintas === 1 ? '' : 's' %>
              <% } %>
            </td>
            <td>
              <% if (o.usos_a_avaliar > 0) { %>
                <span class="chip chip-avaliar"><%= o.usos_a_avaliar %> a avaliar</span>
              <% } else if (o.total_usos > 0) { %>
                <span class="chip chip-validado">Validado</span>
              <% } else { %>
                <span class="detalhe-suave">—</span>
              <% } %>
            </td>
            <td><%= o.total_edicoes %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>