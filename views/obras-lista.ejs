<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <p class="caminho">
    <a href="/">Início</a> › Bibliografia
  </p>

  <h1>Bibliografia</h1>
  <p class="subtitulo">Catálogo de obras</p>

  <form method="GET" action="/obras" class="filtros-obras">
    <input type="text" name="q" placeholder="Buscar por título ou autoria..."
           value="<%= filtros.q %>">

    <select name="tipo">
      <option value="">Todos os tipos</option>
      <% for (const [valor, rotulo] of tiposMaterial) { %>
        <option value="<%= valor %>" <%= filtros.tipo === valor ? 'selected' : '' %>>
          <%= rotulo %>
        </option>
      <% } %>
    </select>

    <select name="estado">
      <option value="">Todos os estados</option>
      <% for (const [valor, rotulo] of estadosVerificacao) { %>
        <option value="<%= valor %>" <%= filtros.estado === valor ? 'selected' : '' %>>
          <%= rotulo %>
        </option>
      <% } %>
    </select>

    <button type="submit">Buscar</button>
    <% if (temFiltro) { %>
      <a href="/obras" class="botao-ghost">Limpar</a>
    <% } %>
  </form>

  <% if (obras.length === 0) { %>
    <p class="aviso-vazio">
      <% if (temFiltro) { %>
        Nenhuma obra encontrada com esses filtros.
      <% } else { %>
        Nenhuma obra cadastrada ainda.
      <% } %>
    </p>
  <% } else { %>
    <p class="contador-resultados">
      <%= obras.length %> obra<%= obras.length === 1 ? '' : 's' %>
      <% if (temFiltro) { %> encontrada<%= obras.length === 1 ? '' : 's' %><% } %>.
    </p>

    <table class="tabela-versoes">
      <thead>
        <tr>
          <th>Título</th>
          <th>Autoria</th>
          <th>Tipo</th>
          <th>Edições</th>
          <th>Usos</th>
          <th>Verificação</th>
        </tr>
      </thead>
      <tbody>
        <% for (const o of obras) { %>
          <tr>
            <td><strong><a href="/obras/<%= o.id %>"><%= o.titulo %></a></strong></td>
            <td><%= o.autores || '—' %></td>
            <td><%= o.rotuloTipoMaterial %></td>
            <td><%= o.total_edicoes %></td>
            <td><%= o.total_usos %></td>
            <td><%= o.rotuloEstadoVerificacao %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>

  <p style="margin-top: 2rem;">
    <a href="/obras/nova" class="botao-ghost">+ Nova Obra</a>
  </p>

  <footer>
    <a href="/health">/health</a>
  </footer>
</body>
</html>