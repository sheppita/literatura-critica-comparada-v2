<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= obra.titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
<%- include('./partials/navbar') %>
  <p class="caminho">
    <a href="/">Início</a> › <a href="/obras">Bibliografia</a> › <%= obra.titulo %>
  </p>

  <% if (typeof salvo !== 'undefined' && salvo) { %>
    <div class="aviso-sucesso">Salvo com sucesso.</div>
  <% } %>

  <% if (obra.arquivada) { %>
    <div class="aviso-neutro">
      Esta obra está <strong>arquivada</strong>. Ela não aparece no catálogo, mas mantém seus usos e edições.
    </div>
  <% } %>

  <h1><%= obra.titulo %></h1>
  <p class="subtitulo">
    <%= obra.rotuloTipoMaterial %>
    <% if (autores.length > 0) { %>
      · <%= autores.map(a => a.nome).join(', ') %>
    <% } %>
  </p>

  <p class="meta-ficha">
    <span class="chip chip-suave"><%= obra.rotuloEstadoVerificacao %></span>
    <% if (totalAulasDistintas > 0) { %>
      <span class="versao">
        <%= totalAulasDistintas %> aula<%= totalAulasDistintas === 1 ? '' : 's' %> distinta<%= totalAulasDistintas === 1 ? '' : 's' %>
      </span>
    <% } %>
  </p>

  <% if (obra.titulo_original || obra.idioma_original) { %>
    <p>
      <% if (obra.titulo_original) { %>
        <strong>Título original:</strong> <%= obra.titulo_original %><br>
      <% } %>
      <% if (obra.idioma_original) { %>
        <strong>Idioma original:</strong> <%= obra.idioma_original %>
      <% } %>
    </p>
  <% } %>

  <% if (obra.observacoes) { %>
    <p><strong>Observações:</strong> <%= obra.observacoes %></p>
  <% } %>

  <p style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/obras/<%= obra.id %>/editar" class="botao-ghost">Editar Obra</a>
  </p>

  <%# ===== EDIÇÕES ===== %>
  <hr class="divisor">
  <h2>Edições</h2>

  <% if (edicoes.length === 0) { %>
    <p class="aviso-vazio">
      Nenhuma edição cadastrada ainda.
    </p>
  <% } else { %>
    <ul class="lista-edicoes">
      <% for (const e of edicoes) { %>
        <li>
          <div style="display: flex; justify-content: space-between; gap: 0.5rem; align-items: baseline;">
            <div>
              <strong><%= e.editora || 'Editora não informada' %></strong>
              <% if (e.ano) { %>, <%= e.ano %><% } %>
              <% if (e.numero_edicao) { %> · <%= e.numero_edicao %><% } %>
              <% if (e.traducao) { %> · Trad.: <%= e.traducao %><% } %>
              <% if (e.idioma) { %> · Idioma: <%= e.idioma %><% } %>
              <span class="chip chip-suave" style="margin-left: 0.5rem;">
                <%= e.rotuloEstadoVerificacao %>
              </span>
            </div>
            <div style="display: flex; gap: 0.4rem;">
              <a href="/obras/<%= obra.id %>/edicoes/<%= e.id %>/editar" class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Editar</a>
              <form method="POST"
                    action="/obras/<%= obra.id %>/edicoes/<%= e.id %>/excluir"
                    style="display:inline;"
                    onsubmit="return confirm('Excluir esta edição?');">
                <button type="submit" class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Excluir</button>
              </form>
            </div>
          </div>
          <% if (e.isbn) { %>
            <div class="detalhe-suave">ISBN: <%= e.isbn %></div>
          <% } %>
          <% if (e.link_referencia) { %>
          <% if (u.caminho) { %>
            <div class="detalhe-suave caminho-uso">
              <%= u.caminho %>
            </div>
          <% } %>
          <div class="detalhe-suave">
            Papel: <%= u.rotuloPapel %> · Modalidade: <%= u.rotuloModalidade %> · Revisão: <%= u.rotuloEstadoRevisao %>
            <% if (u.edicao_id) { %>
              · Edição: <%= u.edicao_editora || '—' %><% if (u.edicao_ano) { %>, <%= u.edicao_ano %><% } %>
            <% } else { %>
              · <em>Edição não informada</em>
            <% } %>
          </div>
          <% } %>
          <% if (e.observacoes) { %>
            <div class="detalhe-suave"><%= e.observacoes %></div>
          <% } %>
        </li>
      <% } %>
    </ul>
  <% } %>

  <p style="margin-top: 1rem;">
    <a href="/obras/<%= obra.id %>/edicoes/nova" class="botao-ghost">+ Adicionar Edição</a>
  </p>

  <%# ===== USOS EM AULAS ===== %>
  <hr class="divisor">
  <h2>Usos em Aulas</h2>

  <% if (usos.length === 0) { %>
    <p class="aviso-vazio">
      Esta obra ainda não está associada a nenhuma aula.
    </p>
  <% } else { %>
    <p class="contador-resultados">
      <%= usos.length %> uso<%= usos.length === 1 ? '' : 's' %>
      em <%= totalAulasDistintas %> aula<%= totalAulasDistintas === 1 ? '' : 's' %>
      distinta<%= totalAulasDistintas === 1 ? '' : 's' %>.
    </p>

    <ul class="lista-usos">
      <% for (const u of usos) { %>
        <li class="uso-item">
          <div>
            <a href="/unidades/<%= u.aula_id %>"><strong><%= u.aula_titulo %></strong></a>
            <% if (u.aula_codigo) { %> · <%= u.aula_codigo %><% } %>
          </div>
          <div class="detalhe-suave">
            Papel: <%= u.rotuloPapel %> · Modalidade: <%= u.rotuloModalidade %> · Revisão: <%= u.rotuloEstadoRevisao %>
            <% if (u.edicao_id) { %>
              · Edição: <%= u.edicao_editora || '—' %><% if (u.edicao_ano) { %>, <%= u.edicao_ano %><% } %>
            <% } %>
          </div>
          <% if (u.recortes.length > 0) { %>
            <div class="detalhe-suave">
              Recortes:
              <%= u.recortes.map(r => {
                if (r.tipo === 'integral') return 'Obra integral';
                if (r.tipo === 'a_conferir') return 'A conferir';
                const inicio = r.inicio || '';
                const fim = r.fim || '';
                const intervalo = inicio && fim ? `${inicio}–${fim}` : (inicio || fim);
                const base = (r.rotulo || r.tipo) + (intervalo ? ` (${intervalo})` : '');
                return r.observacao ? `${base} — ${r.observacao}` : base;
              }).join(' · ') %>
            </div>
          <% } else if (u.modalidade === 'parcial') { %>
            <div class="detalhe-suave">
              Recortes: <em>Recorte não informado</em>
            </div>
          <% } %>
          
          <% if (u.orientacao) { %>
            <div class="detalhe-suave"><em><%= u.orientacao %></em></div>
          <% } %>
          <div style="margin-top: 0.4rem;">
            <a href="/unidades/<%= u.aula_id %>/usos/<%= u.id %>/editar" class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Editar Uso</a>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>

  <%# ===== DECISÕES DE REVISÃO ===== %>
  <% if (usos.length > 0) { %>
    <hr class="divisor">
    <h2>Decisões de Revisão</h2>

    <% if (decisoes.length === 0) { %>
      <p class="aviso-vazio">
        Nenhuma decisão registrada ainda. Quando você quiser marcar uma repetição
        como validada (ou planejar substituição), registre uma decisão.
      </p>
    <% } else { %>
      <ul class="lista-decisoes">
        <% for (const d of decisoes) { %>
          <li class="decisao-item <%= d.vencida ? 'decisao-vencida' : '' %>">
            <div class="decisao-cabecalho">
              <span class="chip"><%= d.rotuloEstado %></span>
              <span class="detalhe-suave">
                <%= new Date(d.criado_em).toLocaleString('pt-BR') %>
              </span>
              <form method="POST"
                    action="/obras/<%= obra.id %>/decisoes/<%= d.id %>/excluir"
                    style="display:inline;"
                    onsubmit="return confirm('Excluir esta decisão? Ela não afeta os usos, só o registro da decisão.');">
                <button type="submit" class="botao-ghost"
                        style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Excluir</button>
              </form>
            </div>

            <% if (d.vencida) { %>
              <div class="aviso-vencida">
                ⚠ Algum dos usos desta decisão foi alterado depois dela. Talvez seja hora de revisar.
              </div>
            <% } %>

            <div class="decisao-justificativa"><%= d.justificativa %></div>

            <div class="detalhe-suave">
              Cobre <%= d.usos.length %> uso<%= d.usos.length === 1 ? '' : 's' %>:
              <ul style="margin: 0.3rem 0 0 1rem;">
                <% for (const u of d.usos) { %>
                  <li><%= u.aula_titulo %> (<%= u.rotuloPapel %>)</li>
                <% } %>
              </ul>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>

    <p style="margin-top: 1rem;">
      <a href="/obras/<%= obra.id %>/decisoes/nova" class="botao-ghost">+ Registrar Decisão</a>
    </p>
  <% } %>

  <p style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/obras" class="botao-ghost">Voltar à Bibliografia</a>
    <a href="/obras/mesclar" class="botao-ghost">Mesclar Obras</a>
  </p>

  <footer>
    <a href="/health">/health</a>
  </footer>
<%- include('./partials/botoes-flutuantes') %>
</body>
</html>