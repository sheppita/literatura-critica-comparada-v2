<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= obra.titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a> › <a href="/obras">Bibliografia</a> › <%= obra.titulo %>
  </p>

  <% if (typeof salvo !== 'undefined' && salvo) { %>
    <div class="aviso-sucesso">Salvo com sucesso.</div>
  <% } %>

  <% if (obra.arquivada) { %>
    <div class="aviso-neutro">
      Esta obra está <strong>arquivada</strong>. Ela não aparece no catálogo, mas mantém seus usos.
    </div>
  <% } %>

  <div style="display: flex; gap: 1.5rem; align-items: flex-start; margin-bottom: 1rem;">
    <% if (obra.capa_url) { %>
      <img src="<%= obra.capa_url %>" alt="" class="miniatura-capa" style="width: 120px; height: 180px;">
    <% } %>
    
    <div>
      <h1 style="margin-top: 0;"><%= obra.titulo %></h1>
      <p class="subtitulo">
        <%= obra.rotuloTipoMaterial %>
        <% if (autores.length > 0) { %>
          · <%= autores.map(a => a.nome).join(', ') %>
        <% } %>
        <% if (obra.editora) { %>
          · <%= obra.editora %>
        <% } %>
      </p>

      <p class="meta-ficha">
        <% if (totalAulasDistintas > 0) { %>
          <span class="versao">
            <%= totalAulasDistintas %> aula<%= totalAulasDistintas === 1 ? '' : 's' %> distinta<%= totalAulasDistintas === 1 ? '' : 's' %>
          </span>
        <% } %>
      </p>

      <% if (obra.observacoes) { %>
        <p><strong>Observações:</strong> <%= obra.observacoes %></p>
      <% } %>

      <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
        <a href="/obras/<%= obra.id %>/editar" class="botao-ghost">Editar Obra</a>
              <form method="POST" action="/obras/<%= obra.id %>/excluir"
              style="display:inline; margin: 0;"
              onsubmit="return confirm('Excluir esta obra? Esta ação não pode ser desfeita. Só é possível excluir obras que não estão em uso.');">
          <button type="submit" class="botao-ghost" style="background: #c0392b; color: #fff; border-color: #c0392b;">
            Excluir Obra
          </button>
        </form>
      </div>
    </div>
  </div>

  <%# ===== USOS EM AULAS ===== %>
  <hr class="divisor">
  <h2>Usos em Aulas</h2>

  <% if (usos.length === 0) { %>
    <p class="aviso-vazio">
      Esta obra ainda não está associada a nenhuma aula.
    </p>
  <% } else { %>
    <p class="contador-resultados">
      <%= usos.length %> uso<%= usos.length === 1 ? '' : 's' %>
      em <%= totalAulasDistintas %> aula<%= totalAulasDistintas === 1 ? '' : 's' %>
      distinta<%= totalAulasDistintas === 1 ? '' : 's' %>.
    </p>

    <ul class="lista-usos">
      <% for (const u of usos) { %>
        <li class="uso-item <%= u.a_avaliar ? 'uso-a-avaliar' : '' %>">
          <div class="uso-com-capa">
            <div class="uso-corpo">
              <div class="uso-cabecalho">
                <div>
                  <a href="/unidades/<%= u.aula_id %>"><strong><%= u.aula_titulo %></strong></a>
                  <% if (u.aula_codigo) { %> · <%= u.aula_codigo %><% } %>
                </div>
                <div class="uso-acoes">
                  <span class="chip <%= u.a_avaliar ? 'chip-avaliar' : 'chip-validado' %>">
                    <%= u.rotuloEstado %>
                  </span>
                </div>
              </div>
              <% if (u.caminho) { %>
                <div class="detalhe-suave caminho-uso">
                  <%= u.caminho %>
                </div>
              <% } %>
              <div class="detalhe-suave">
                Papel: <%= u.rotuloPapel %> · Modalidade: <%= u.rotuloModalidade %>
              </div>
              <% if (u.recortes.length > 0) { %>
                <div class="detalhe-suave">
                  Recortes:
                  <% 
                    let itensRecorte = [];
                    for (let r of u.recortes) {
                      let rotulo = r.rotulo || "";
                      let obs = r.observacao || "";
                      let textoFinal = "";
                      if (rotulo && obs) {
                        textoFinal = rotulo + " — " + obs;
                      } else if (rotulo) {
                        textoFinal = rotulo;
                      } else if (obs) {
                        textoFinal = obs;
                      } else {
                        textoFinal = "Recorte sem nome";
                      }
                      itensRecorte.push(textoFinal);
                    }
                  %>
                  <%= itensRecorte.join(' · ') %>
                </div>
              <% } else if (u.modalidade === 'parcial') { %>
                <div class="detalhe-suave">
                  Recortes: <em>Recorte não informado</em>
                </div>
              <% } %>
              <% if (u.orientacao) { %>
                <div class="detalhe-suave"><em><%= u.orientacao %></em></div>
              <% } %>
              <div class="uso-botoes">
                <% if (u.a_avaliar) { %>
                  <form method="POST" action="/unidades/<%= u.aula_id %>/usos/<%= u.id %>/validar" style="display:inline;">
                    <button type="submit" class="botao-ghost botao-validar">Validar</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/unidades/<%= u.aula_id %>/usos/<%= u.id %>/reabrir" style="display:inline;"
                        onsubmit="return confirm('Reabrir este uso para avaliação?');">
                    <button type="submit" class="botao-ghost botao-reabrir">Reabrir</button>
                  </form>
                <% } %>
                <a href="/unidades/<%= u.aula_id %>/usos/<%= u.id %>/editar" class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Editar Uso</a>
              </div>
            </div>
          </div>
        </li>
      <% } %>
    </ul>
  <% } %>

  <p style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/obras" class="botao-ghost">Voltar à Bibliografia</a>
    <a href="/obras/mesclar" class="botao-ghost">Mesclar Obras</a>
  </p>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>