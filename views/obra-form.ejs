<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a> › <a href="/obras">Bibliografia</a> ›
    <% if (modo === 'editar') { %>
      <a href="/obras/<%= obraId %>"><%= valores.titulo %></a> › Editar
    <% } else { %>
      Nova Obra
    <% } %>
  </p>

  <h1><%= modo === 'editar' ? 'Editar Obra' : 'Nova Obra' %></h1>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= acao %>">
    <label for="titulo">Título <span class="ajuda">(obrigatório)</span></label>
    <input type="text" id="titulo" name="titulo" value="<%= valores.titulo %>" autofocus>

    <label for="autores">Autoria <span class="ajuda">(um autor por linha)</span></label>
    <textarea id="autores" name="autores" rows="3"><%= valores.autores %></textarea>

    <label for="tipo_material">Tipo de material</label>
    <select id="tipo_material" name="tipo_material">
      <% for (const [valor, rotulo] of tiposMaterial) { %>
        <option value="<%= valor %>" <%= valores.tipo_material === valor ? 'selected' : '' %>>
          <%= rotulo %>
        </option>
      <% } %>
    </select>

    <% if (modo === 'criar') { %>
      <hr class="divisor">
      <h2>Primeira Edição <span class="ajuda">(opcional; preencha o que souber)</span></h2>

      <label for="edicao_editora">Editora</label>
      <input type="text" id="edicao_editora" name="edicao_editora" value="<%= valores.edicao_editora %>">

      <label for="edicao_ano">Ano</label>
      <input type="text" id="edicao_ano" name="edicao_ano" value="<%= valores.edicao_ano %>">

      <label for="edicao_capa_url">URL da capa <span class="ajuda">(opcional; link direto para uma imagem)</span></label>
      <input type="text" id="edicao_capa_url" name="edicao_capa_url" value="<%= valores.edicao_capa_url %>"
             placeholder="https://...">
    <% } %>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="botao-ghost" href="<%= cancelarUrl %>">Cancelar</a>
    </div>
  </form>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>