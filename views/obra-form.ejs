    <option value="Zimbábue"></option>
  </datalist>

    <label for="tipo_material">Tipo de material</label>
    <select id="tipo_material" name="tipo_material">
      <% for (const [valor, rotulo] of tiposMaterial) { %>
        <option value="<%= valor %>" <%= valores.tipo_material === valor ? 'selected' : '' %>>
          <%= rotulo %>
        </option>
      <% } %>
    </select>

    <% if (modo === 'criar') { %>
      <hr class="divisor">
      <h2>Primeira Edição <span class="ajuda">(opcional; preencha o que souber)</span></h2>

      <label for="edicao_editora">Editora</label>
      <input type="text" id="edicao_editora" name="edicao_editora" value="<%= valores.edicao_editora %>">

      <label for="edicao_ano">Ano</label>
      <input type="text" id="edicao_ano" name="edicao_ano" value="<%= valores.edicao_ano %>">

      <label for="edicao_capa_url">URL da capa <span class="ajuda">(opcional; link direto para uma imagem)</span></label>
      <input type="text" id="edicao_capa_url" name="edicao_capa_url" value="<%= valores.edicao_capa_url %>"
             placeholder="https://...">
    <% } %>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="botao-ghost" href="<%= cancelarUrl %>">Cancelar</a>
    </div>
  </form>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>