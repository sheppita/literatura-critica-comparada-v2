<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a> › <a href="/obras">Bibliografia</a> ›
    <% if (modo === 'editar') { %>
      <a href="/obras/<%= obraId %>"><%= valores.titulo %></a> › Editar
    <% } else { %>
      Nova Obra
    <% } %>
  </p>

  <h1><%= modo === 'editar' ? 'Editar Obra' : 'Nova Obra' %></h1>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= acao %>">
    <label for="titulo">Título <span class="ajuda">(obrigatório)</span></label>
    <input type="text" id="titulo" name="titulo" value="<%= valores.titulo %>" autofocus>

    <label for="autores">Autoria <span class="ajuda">(um autor por linha)</span></label>
    <textarea id="autores" name="autores" rows="3"><%= valores.autores %></textarea>
      <label for="pais_autor">País do Autor</label>
  <span class="ajuda">Selecione na lista ou digite para filtrar.</span>
  <input 
    type="text" 
    id="pais_autor" 
    name="pais_autor" 
    list="lista-paises" 
    placeholder="Ex: Brasil"
    value="<%= typeof valores.pais_autor !== 'undefined' ? valores.pais_autor : '' %>"
  >
  <!-- Lista fixa de países -->
  <datalist id="lista-paises">
