<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <p class="caminho">
    <a href="/">Início</a> › <a href="/obras">Bibliografia</a> ›
    <a href="/obras/<%= obra.id %>"><%= obra.titulo %></a> ›
    <%= modo === 'editar' ? 'Editar Edição' : 'Nova Edição' %>
  </p>

  <h1><%= modo === 'editar' ? 'Editar Edição' : 'Nova Edição' %></h1>
  <p class="subtitulo"><%= obra.titulo %></p>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= acao %>">
    <label for="editora">Editora</label>
    <input type="text" id="editora" name="editora" value="<%= valores.editora %>" autofocus>

    <label for="ano">Ano</label>
    <input type="text" id="ano" name="ano" value="<%= valores.ano %>">

    <label for="capa_url">URL da capa <span class="ajuda">(opcional; link direto para uma imagem)</span></label>
    <input type="text" id="capa_url" name="capa_url" value="<%= valores.capa_url %>"
           placeholder="https://...">

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="botao-ghost" href="<%= cancelarUrl %>">Cancelar</a>
    </div>
  </form>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>