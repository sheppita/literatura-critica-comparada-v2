<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <style>
    body {
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      max-width: 720px;
      margin: 2rem auto;
      padding: 0 1rem;
      line-height: 1.55;
      color: #222;
    }
    h1 { font-size: 1.4rem; margin-bottom: 0.25rem; }
    .caminho { font-size: 0.9rem; color: #666; margin-bottom: 1.5rem; }
    .caminho a { color: #666; }
    label { display: block; font-weight: 600; margin-top: 1.2rem; margin-bottom: 0.25rem; }
    .ajuda { font-weight: normal; color: #777; font-size: 0.85rem; }
    input[type="text"], input[type="number"], textarea {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-family: inherit;
      font-size: 1rem;
      box-sizing: border-box;
    }
    textarea { min-height: 5rem; resize: vertical; }
    .superior-fixo {
      background: #f4f4f4;
      border-left: 4px solid #999;
      padding: 0.5rem 0.75rem;
      margin-top: 0.5rem;
      font-size: 0.9rem;
      color: #444;
    }
    .erros {
      background: #fdecea;
      border-left: 4px solid #c0392b;
      padding: 0.75rem 1rem;
      color: #7b1e1e;
      margin-bottom: 1rem;
    }
    .erros ul { margin: 0.25rem 0 0 1rem; padding: 0; }
    .acoes { margin-top: 2rem; display: flex; gap: 0.75rem; align-items: center; }
    button {
      background: #2c5e8a;
      color: white;
      border: none;
      padding: 0.55rem 1.2rem;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
    }
    button:hover { background: #234a6d; }
    .cancelar { color: #666; text-decoration: none; }
    footer { margin-top: 3rem; font-size: 0.85rem; color: #888; }
  </style>
</head>
<body>
  <p class="caminho"><a href="/">Início</a> › <%= rotuloTipo %> nova</p>
  <h1><%= titulo %></h1>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/unidades/nova">
    <input type="hidden" name="tipo" value="<%= tipo %>">
    <% if (superior) { %>
      <input type="hidden" name="superior_id" value="<%= superior.id %>">
    <% } %>

    <% if (superior) { %>
      <div class="superior-fixo">
        Pertence a: <strong><%= superior.titulo %></strong>
        (nível: <%= superior.tipo %>)
      </div>
    <% } %>

    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo"
           value="<%= valores.titulo %>" autofocus>

    <label for="codigo">Código visível <span class="ajuda">(opcional)</span></label>
    <input type="text" id="codigo" name="codigo"
           value="<%= valores.codigo %>">

    <label for="descricao">Descrição <span class="ajuda">(opcional)</span></label>
    <textarea id="descricao" name="descricao"><%= valores.descricao %></textarea>

    <% if (tipo === 'tema') { %>
      <label for="pergunta_norteadora">
        Pergunta norteadora
        <span class="ajuda">(opcional nesta etapa)</span>
      </label>
      <textarea id="pergunta_norteadora" name="pergunta_norteadora"><%= valores.pergunta_norteadora %></textarea>
    <% } %>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="caminho cancelar" href="/">Cancelar</a>
    </div>
  </form>

  <footer>
    <a href="/health">/health</a>
  </footer>
</body>
</html>