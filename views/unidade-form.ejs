<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> — Literatura Crítica Comparada</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <p class="caminho">
    <a href="/">Início</a>
    <% if (superior) { %>
      › <a href="/unidades/<%= superior.id %>"><%= superior.titulo %></a>
    <% } %>
    › <%= modo === 'editar' ? 'Editar' : (rotuloTipo + ' nova') %>
  </p>
  <h1><%= titulo %></h1>

  <% if (erros && erros.length > 0) { %>
    <div class="erros">
      <strong>Não foi possível salvar:</strong>
      <ul>
        <% for (const e of erros) { %>
          <li><%= e %></li>
        <% } %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= acao %>">
    <% if (modo === 'criar') { %>
      <input type="hidden" name="tipo" value="<%= tipo %>">
      <% if (superior) { %>
        <input type="hidden" name="superior_id" value="<%= superior.id %>">
      <% } %>
    <% } %>

    <% if (superior) { %>
      <div class="superior-fixo">
        Pertence a: <strong><%= superior.titulo %></strong>
        (nível: <%= superior.tipo %>)
      </div>
    <% } %>

    <label for="titulo">Título</label>
    <input type="text" id="titulo" name="titulo"
           value="<%= valores.titulo %>" autofocus>

    <label for="codigo">Código visível <span class="ajuda">(opcional)</span></label>
    <input type="text" id="codigo" name="codigo"
           value="<%= valores.codigo %>">

    <label for="descricao">Descrição <span class="ajuda">(opcional)</span></label>
    <textarea id="descricao" name="descricao"><%= valores.descricao %></textarea>

    <% if (tipo === 'tema') { %>
      <label for="pergunta_norteadora">
        Pergunta norteadora
        <span class="ajuda">(opcional nesta etapa)</span>
      </label>
      <textarea id="pergunta_norteadora" name="pergunta_norteadora"><%= valores.pergunta_norteadora %></textarea>
    <% } %>

    <div class="acoes">
      <button type="submit">Salvar</button>
      <a class="caminho cancelar" href="<%= cancelarUrl %>">Cancelar</a>
    </div>
  </form>

  <footer>
    <a href="/health">/health</a>
  </footer>
</body>
</html>