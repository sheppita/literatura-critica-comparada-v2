<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= unidade.titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>

  <% if (typeof salvo !== 'undefined' && salvo) { %>
    <div class="aviso-sucesso">
      Ficha salva com sucesso.
    </div>
  <% } %>
  <% if (typeof nadaMudou !== 'undefined' && nadaMudou) { %>
    <div class="aviso-neutro">
      Nada foi alterado — a versão continua a mesma.
    </div>
  <% } %>

    <p class="caminho">
    <a href="/">Início</a>
    <% for (const u of cadeia) { %>
      › <a href="/unidades/<%= u.id %>"><%= u.titulo %></a>
    <% } %>
    › <%= unidade.titulo %>
  </p>

  <h1><%= unidade.titulo %></h1>
  <p class="subtitulo">
    <%= rotuloTipo %><% if (unidade.codigo) { %> · <%= unidade.codigo %><% } %>
  </p>

  <% if (unidade.descricao) { %>
    <p><%= unidade.descricao %></p>
  <% } %>

  <% if (unidade.tipo === 'tema' && unidade.pergunta_norteadora) { %>
    <div class="aviso-vazio">
      <strong>Pergunta Norteadora:</strong> <%= unidade.pergunta_norteadora %>
    </div>
  <% } %>

  <%# Bloco da ficha — só para aula %>
  <% if (unidade.tipo === 'aula') { %>
    <hr class="divisor">

    <% if (!ficha) { %>
      <p class="aviso-vazio">
        Não há ficha registrada para esta aula.
      </p>
    <% } else { %>
      <p class="meta-ficha">
        <span class="chip"><%= ficha.rotuloEstadoTexto %></span>
        <span class="chip chip-suave"><%= ficha.rotuloEstadoBibliografia %></span>
        <span class="versao">v<%= ficha.versao_atual %></span>
      </p>

      <% if (ficha.conteudo_html) { %>
        <div class="ficha-conteudo">
          <%- ficha.conteudo_html %>
        </div>
      <% } else { %>
        <p class="aviso-vazio">
          Ficha ainda em branco.
        </p>
      <% } %>

        <p style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
             <a href="/unidades/<%= unidade.id %>/ficha/editar" class="botao-ghost">
          Editar Ficha
              </a>
              <a href="/unidades/<%= unidade.id %>/ficha/versoes" class="botao-ghost">
          Histórico
              </a>
         </p>
    <% } %>
  <% } %>

  <% if (nomeFilhoPlural) { %>
    <h2>
      <%= nomeFilhoPlural.charAt(0).toUpperCase() + nomeFilhoPlural.slice(1) %>
    </h2>

    <% if (filhos.length === 0) { %>
      <p class="aviso-vazio">
        Ainda não há <%= nomeFilhoPlural %> aqui.
      </p>
    <% } else { %>
      <ul>
        <% for (const f of filhos) { %>
          <li>
            <% if (f.codigo) { %><strong><%= f.codigo %></strong> — <% } %>
            <a href="/unidades/<%= f.id %>"><%= f.titulo %></a>
          </li>
        <% } %>
      </ul>
    <% } %>

    <p style="margin-top: 1.5rem;">
      <a href="/unidades/nova?tipo=<%= proximoNivel %>&superior_id=<%= unidade.id %>">
        + <%= rotuloNovoProximo %>
      </a>
    </p>
  <% } %>

  <p style="margin-top: 2rem;">
    <a href="/unidades/<%= unidade.id %>/editar">Editar</a>
    ·
    <a href="/unidades/<%= unidade.id %>/excluir">Excluir</a>
  </p>

  <footer>
    <a href="/health">/health</a>
  </footer>
</body>
</html>