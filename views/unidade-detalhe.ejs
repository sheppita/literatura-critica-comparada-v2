<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= unidade.titulo %> — Literatura Crítica Comparada</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <%- include('./partials/navbar') %>

  <% if (typeof salvo !== 'undefined' && salvo) { %>
    <div class="aviso-sucesso">
      Ficha salva com sucesso.
    </div>
  <% } %>
  <% if (typeof nadaMudou !== 'undefined' && nadaMudou) { %>
    <div class="aviso-neutro">
      Nada foi alterado — a versão continua a mesma.
    </div>
  <% } %>

  <p class="caminho">
    <a href="/">Início</a>
    <% for (const u of cadeia) { %>
      › <a href="/unidades/<%= u.id %>"><%= u.titulo %></a>
    <% } %>
    › <%= unidade.titulo %>
  </p>

  <h1><%= unidade.titulo %></h1>
  <p class="subtitulo">
    <% if (typeof rotuloTipoExibido !== 'undefined' && rotuloTipoExibido) { %>
      <%= rotuloTipoExibido %><% if (unidade.codigo) { %> · <% } %>
    <% } %>
    <% if (unidade.codigo) { %><%= unidade.codigo %><% } %>
  </p>

  <% if (unidade.descricao) { %>
    <p><%= unidade.descricao %></p>
  <% } %>

  <% if (unidade.tipo === 'tema' && unidade.pergunta_norteadora) { %>
    <div class="aviso-vazio">
      <strong>Pergunta Norteadora:</strong> <%= unidade.pergunta_norteadora %>
    </div>
  <% } %>

  <%# Bloco da ficha — só para aula %>
  <% if (unidade.tipo === 'aula') { %>
    <hr class="divisor">

    <% if (!ficha) { %>
      <p class="aviso-vazio">
        Não há ficha registrada para esta aula.
      </p>
    <% } else { %>
      <p class="meta-ficha">
        <span class="chip"><%= ficha.rotuloEstadoTexto %></span>
        <span class="chip chip-suave"><%= ficha.rotuloEstadoBibliografia %></span>
        <span class="versao">v<%= ficha.versao_atual %></span>
      </p>

      <% if (ficha.conteudo_html) { %>
        <div class="ficha-conteudo">
          <%- ficha.conteudo_html %>
        </div>
      <% } else { %>
        <p class="aviso-vazio">
          Ficha ainda em branco.
        </p>
      <% } %>

      <p style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/unidades/<%= unidade.id %>/ficha/editar" class="botao-ghost">
          Editar Ficha
        </a>
        <a href="/unidades/<%= unidade.id %>/ficha/versoes" class="botao-ghost">
          Histórico
        </a>
      </p>
    <% } %>
  <% } %>

  <%# Bloco de usos — só para aula %>
  <% if (unidade.tipo === 'aula') { %>
    <hr class="divisor">
    <h2>Bibliografia</h2>

    <% if (!usosAula || usosAula.length === 0) { %>
      <p class="aviso-vazio">
        Nenhuma obra associada a esta aula ainda.
      </p>
    <% } else { %>
      <ul class="lista-usos-aula">
        <% for (const u of usosAula) { %>
          <li class="uso-aula-item <%= u.a_avaliar ? 'uso-a-avaliar' : '' %>">
            <div class="uso-com-capa">
              <% if (u.edicao_capa_url) { %>
                <img src="<%= u.edicao_capa_url %>" alt="" class="miniatura-capa miniatura-capa-uso">
              <% } %>
              <div class="uso-corpo">
                <div class="uso-cabecalho">
                  <span class="uso-obra">
                    <a href="/obras/<%= u.obra_id %>"><%= u.obra_titulo %></a>
                    <% if (u.obra_autores) { %> — <%= u.obra_autores %><% } %>
                  </span>
                  <span class="uso-acoes">
                    <span class="chip <%= u.a_avaliar ? 'chip-avaliar' : 'chip-validado' %>">
                      <%= u.rotuloEstado %>
                    </span>
                  </span>
                </div>
                <div class="detalhe-suave">
                  <%= u.rotuloPapel %> · <%= u.rotuloModalidade %>
                  <% if (u.edicao_id) { %>
                    · Edição: <%= u.edicao_editora || '—' %><% if (u.edicao_ano) { %>, <%= u.edicao_ano %><% } %>
                  <% } else { %>
                    · <em>Edição não informada</em>
                  <% } %>
                </div>
                <% if (u.recortes.length > 0) { %>
                  <div class="detalhe-suave">
                    Recortes:
                    <%= u.recortes.map(r => {
                      if (r.tipo === 'a_conferir') return 'A conferir';
                      const base = r.rotulo || r.tipo;
                      return r.observacao ? `${base} — ${r.observacao}` : base;
                    }).join(' · ') %>
                  </div>
                <% } else if (u.modalidade === 'parcial') { %>
                  <div class="detalhe-suave">
                    Recortes: <em>Recorte não informado</em>
                  </div>
                <% } %>
                <% if (u.orientacao) { %>
                  <div class="detalhe-suave"><em><%= u.orientacao %></em></div>
                <% } %>
                <div class="uso-botoes">
                  <% if (u.a_avaliar) { %>
                    <form method="POST" action="/unidades/<%= unidade.id %>/usos/<%= u.id %>/validar" style="display:inline;">
                      <button type="submit" class="botao-ghost botao-validar">Validar</button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/unidades/<%= unidade.id %>/usos/<%= u.id %>/reabrir" style="display:inline;"
                          onsubmit="return confirm('Reabrir este uso para avaliação?');">
                      <button type="submit" class="botao-ghost botao-reabrir">Reabrir</button>
                    </form>
                  <% } %>
                  <a href="/unidades/<%= unidade.id %>/usos/<%= u.id %>/editar"
                     class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Editar</a>
                  <form method="POST"
                        action="/unidades/<%= unidade.id %>/usos/<%= u.id %>/excluir"
                        style="display:inline;"
                        onsubmit="return confirm('Remover esta obra da aula? A obra em si continua no catálogo.');">
                    <button type="submit" class="botao-ghost" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Remover</button>
                  </form>
                </div>
              </div>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>

    <p style="margin-top: 1rem;">
      <a href="/unidades/<%= unidade.id %>/usos/novo" class="botao-ghost">+ Adicionar Obra</a>
    </p>
  <% } %>

  <% if (nomeFilhoPlural) { %>
    <hr class="divisor">
    <h2>
      <%= nomeFilhoPlural.charAt(0).toUpperCase() + nomeFilhoPlural.slice(1) %>
    </h2>

    <% if (filhos.length === 0) { %>
      <p class="aviso-vazio">
        Ainda não há <%= nomeFilhoPlural %> aqui.
      </p>
    <% } else { %>
      <ul>
        <% for (const f of filhos) { %>
          <li>
            <% if (f.codigo) { %><strong><%= f.codigo %></strong> — <% } %>
            <a href="/unidades/<%= f.id %>"><%= f.titulo %></a>
          </li>
        <% } %>
      </ul>
    <% } %>

    <p style="margin-top: 1.5rem;">
      <a href="/unidades/nova?tipo=<%= proximoNivel %>&superior_id=<%= unidade.id %>">
        + <%= rotuloNovoProximo %>
      </a>
    </p>
  <% } %>

  <p style="margin-top: 2rem;">
    <a href="/unidades/<%= unidade.id %>/editar">Editar</a>
    ·
    <a href="/unidades/<%= unidade.id %>/excluir">Excluir</a>
  </p>

  <%- include('./partials/botoes-flutuantes') %>
</body>
</html>